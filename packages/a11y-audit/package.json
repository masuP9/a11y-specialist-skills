{
  "name": "@a11y-skills/audit",
  "version": "0.16.1",
  "description": "Playwright + axe-core based WCAG 2.2 accessibility audit functions (axe, focus indicator, keyboard trap, keyboard reachability, reflow, target size, text spacing, zoom, orientation, autocomplete, time limit, auto-play, redundant entry, motion actuation, change on input, accessible authentication, pointer gestures, focus order, pointer cancellation, non-text contrast, character key shortcuts, content on hover or focus) plus a page snapshot (aria snapshot, title, lang) for agent review.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "masuP9",
    "url": "https://github.com/masuP9"
  },
  "repository": {
