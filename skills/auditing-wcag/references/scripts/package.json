{
  "name": "wcag-audit-scripts",
  "version": "1.0.0",
  "description": "WCAG audit automation scripts using Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:axe": "node run-test.cjs axe-audit.ts",
    "test:focus": "node run-test.cjs focus-indicator-check.ts",
    "test:reflow": "node run-test.cjs reflow-check.ts",
    "test:text-spacing": "node run-test.cjs text-spacing-check.ts",
    "test:orientation": "node run-test.cjs orientation-check.ts",
    "test:autocomplete": "node run-test.cjs autocomplete-audit.ts",
    "test:target-size": "node run-test.cjs target-size-check.ts",
    "test:time-limit": "node run-test.cjs time-limit-detector.ts",
    "test:zoom": "node run-test.cjs zoom-200-check.ts",
    "test:auto-play": "node run-test.cjs auto-play-detection.ts",
    "test:all": "node run-test.cjs \"axe-audit.ts focus-indicator-check.ts reflow-check.ts text-spacing-check.ts zoom-200-check.ts orientation-check.ts autocomplete-audit.ts target-size-check.ts time-limit-detector.ts auto-play-detection.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@a11y-skills/audit": "^0.2.0",
    "@playwright/test": "^1.58.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
